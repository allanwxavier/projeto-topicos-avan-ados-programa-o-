generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int @id  @default(autoincrement())
  name      String
  password  String
  token     String?
  criadoEm  DateTime @default(now())

  participacoes ParticipanteReuniao[]

  @@map("usuarios")
}

model Reuniao {
  id Int       @id      @default(autoincrement())
  assunto      String
  local        String
  data         String
  horaInicio   String
  horaFim      String
  criadoEm     DateTime @default(now())
  
  status String @default("Agendada")

  participantes ParticipanteReuniao[]

  @@map("reunioes")
}

model ParticipanteReuniao {
  id             Int @id @default(autoincrement())
  idReuniao      Int
  idParticipante Int

  reuniao Reuniao @relation(fields: [idReuniao], references: [id])
  usuario Usuario @relation(fields: [idParticipante], references: [id])

  @@map("participantes_reuniao")
}

model KanbanCard {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  columnId    String   @default("backlog")
  priority    Int      @default(0)
  assignee    String?
  tags        String[] @default([])
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("kanban_cards")
}
