# ════════════════════════════════════════════════════════════════
#  .env.example — Configuração do Node.js API
# ════════════════════════════════════════════════════════════════
#  COMO USAR:
#  1. Copia este arquivo: cp backend/.env.example backend/.env
#  2. Os valores abaixo já estão prontos para rodar com docker-compose
#  3. Para rodar Node FORA do Docker (npm run dev), troca:
#     - postgres → localhost:5433
#     - rabbitmq → localhost:5672
# ════════════════════════════════════════════════════════════════

# ─── API ───
API_PORT=8081
NODE_ENV=development

# ─── Banco PostgreSQL ───
# Dentro do Docker, o host é o nome do container ("postgres")
DATABASE_URL=postgresql://meetsync:meetsync123@postgres:5432/meetsync?schema=public

# ─── RabbitMQ ───
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672

# ─── JWT ───
JWT_SECRET=segredo_super_secreto_do_trabalho
JWT_EXPIRES_IN=7d
